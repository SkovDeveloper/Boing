<Page
    x:Class="Boing.Views.ProrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="8" Margin="0,0,48,48">
        <controls:SettingsExpander
            IsExpanded="True"
            Visibility="{x:Bind ProrationsVisibility, Mode=OneWay}"
            Header="Prorrateo primario"
            Description="{x:Bind PrimaryDescription, Mode=OneWay}">

            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8EF;" />
            </controls:SettingsExpander.HeaderIcon>

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="PrimaryMatrixGrid" Padding="12,8" ColumnSpacing="20" RowSpacing="4" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="PrimaryTotalGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            IsExpanded="True"
            Visibility="{x:Bind ProrationsVisibility, Mode=OneWay}"
            Header="Prorrateo secundario"
            Description="{x:Bind SecondaryDescription, Mode=OneWay}">

            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8AB;" />
            </controls:SettingsExpander.HeaderIcon>

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="SecondaryMatrixGrid" Padding="12,8" ColumnSpacing="20" RowSpacing="4" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="SecondaryTotalGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            IsExpanded="True"
            Visibility="{x:Bind ProrationsVisibility, Mode=OneWay}"
            Header="Prorrateo final"
            Description="{x:Bind FinalDescription, Mode=OneWay}">

            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE9D2;" />
            </controls:SettingsExpander.HeaderIcon>

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="FinalMatrixGrid" Padding="12,8" ColumnSpacing="20" RowSpacing="4" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="FinalTotalGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            IsExpanded="True"
            Visibility="{x:Bind CupVisibility, Mode=OneWay}"
            Header="Costo unitario de producción"
            Description="{x:Bind CupDescription, Mode=OneWay}">

            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE9F9;" />
            </controls:SettingsExpander.HeaderIcon>

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="CupMatrixGrid" Padding="12,8" ColumnSpacing="20" RowSpacing="4" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="CupTotalProcessedGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="CupFinishedUnitsGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="CupUnitCostGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="CupSalePriceGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>

                <controls:SettingsCard
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="CupIfppGrid" Padding="12,4" ColumnSpacing="20" />
                    </ScrollViewer>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
    </StackPanel>
</Page>