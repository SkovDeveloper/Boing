<Page
    x:Class="Boing.Views.EcpvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="24" Margin="0,0,48,48">
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.EcpvVisibility, Mode=OneWay}">
            <StackPanel Spacing="2" Margin="4,0,0,8">
                <TextBlock Text="{x:Bind ViewModel.CompanyHeaderText, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Estado de costo de producción y de lo vendido"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.PeriodHeaderText, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <controls:SettingsExpander
                IsExpanded="True"
                Header="Materia prima directa"
                Description="{x:Bind ViewModel.MaterialDescription, Mode=OneWay}">

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Inventario inicial de materia prima directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.InitialDirectMaterialDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Compras netas de materia prima directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.DirectMaterialPurchasesDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Materia prima directa disponible">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.AvailableDirectMaterialDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Inventario final de materia prima directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.FinalDirectMaterialDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Materia prima directa utilizada">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.UsedDirectMaterialDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                IsExpanded="True"
                Header="Costo incurrido"
                Description="{x:Bind ViewModel.IncurredDescription, Mode=OneWay}">

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D2;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Mano de obra directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.DirectLaborDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Cargos indirectos de fabricación">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.OverheadDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo incurrido">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.IncurredCostDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                IsExpanded="True"
                Header="Producción en proceso"
                Description="{x:Bind ViewModel.ProcessDescription, Mode=OneWay}">

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9F9;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Inventario inicial de producción en proceso">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.InitialWipDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Producción procesada disponible">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.TotalProcessedDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Inventario final de producción en proceso">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.FinalWipDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo de producción de artículos terminados">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.FinishedProductionDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                IsExpanded="True"
                Header="Artículos terminados y costo de lo vendido"
                Description="{x:Bind ViewModel.SoldDescription, Mode=OneWay}">

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE719;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Inventario inicial de artículos terminados">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.InitialFgDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Artículos terminados disponibles">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.AvailableFgDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Inventario final de artículos terminados">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.FinalFgDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo de producción de lo vendido">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.CostOfGoodsSoldDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ErVisibility, Mode=OneWay}">
            <StackPanel Spacing="2" Margin="4,0,0,8">
                <TextBlock Text="{x:Bind ViewModel.CompanyHeaderText, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Estado de resultados" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.PeriodHeaderText, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <controls:SettingsExpander
                IsExpanded="True"
                Header="Ventas y utilidad bruta"
                Description="{x:Bind ViewModel.GrossProfitDescription, Mode=OneWay}">

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8C7;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Ventas netas">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.SalesDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo de producción de lo vendido">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.CostOfGoodsSoldDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind ViewModel.GrossProfitHeader, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.GrossProfitDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                IsExpanded="True"
                Header="Gastos de operación y resultado"
                Description="{x:Bind ViewModel.OperatingIncomeDescription, Mode=OneWay}">

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Gastos de venta">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.SellingExpensesDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Gastos de administración">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.AdminExpensesDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind ViewModel.OperatingIncomeHeader, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.OperatingIncomeDisplay, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>

        <controls:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
            <Grid Padding="12,16" ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center" Width="280">
                    <Grid Height="96">
                        <Canvas
                            x:Name="PreparedSignatureCanvas"
                            Background="Transparent"
                            PointerPressed="OnSignaturePointerPressed"
                            PointerMoved="OnSignaturePointerMoved"
                            PointerReleased="OnSignaturePointerReleased"
                            PointerCanceled="OnSignaturePointerReleased" />
                        <Button
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28"
                            Height="28"
                            Padding="0"
                            ToolTipService.ToolTip="Limpiar firma"
                            Click="OnClearPreparedSignatureClick">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.PreparedByDisplay, Mode=OneWay}" HorizontalAlignment="Center" />
                    <TextBlock Text="Elaboró" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center" Width="280">
                    <Grid Height="96">
                        <Canvas
                            x:Name="AuthorizedSignatureCanvas"
                            Background="Transparent"
                            PointerPressed="OnSignaturePointerPressed"
                            PointerMoved="OnSignaturePointerMoved"
                            PointerReleased="OnSignaturePointerReleased"
                            PointerCanceled="OnSignaturePointerReleased" />
                        <Button
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28"
                            Height="28"
                            Padding="0"
                            ToolTipService.ToolTip="Limpiar firma"
                            Click="OnClearAuthorizedSignatureClick">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.AuthorizedByDisplay, Mode=OneWay}" HorizontalAlignment="Center" />
                    <TextBlock Text="Autorizó" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </controls:SettingsCard>
    </StackPanel>
</Page>