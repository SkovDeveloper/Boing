<?xml version="1.0" encoding="utf-8"?>

<Window x:Class="Boing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Flod">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
                  x:Name="WindowTitleBar"
                  Title="Boing de Mango"
                  IsBackButtonVisible="{x:Bind NavigationService.CanGoBack, Mode=OneWay}"
                  IsBackButtonEnabled="{x:Bind NavigationService.CanGoBack, Mode=OneWay}"
                  IsPaneToggleButtonVisible="False"
                  BackRequested="TitleBarBackRequested">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/ApplicationImages/TaskBarIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Rectangle Height="30" />
            </TitleBar.RightHeader>
        </TitleBar>


        <Frame Grid.Row="1" x:Name="ContentFrame">

            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </Grid>

</Window>