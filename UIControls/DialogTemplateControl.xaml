<UserControl x:Class="Boing.UIControls.DialogTemplateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="16" Spacing="24">

        <StackPanel.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </TransitionCollection>
        </StackPanel.ChildrenTransitions>

        <Grid Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Bind Title, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.CancelFormCommand, Mode=OneWay}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="44" Height="44">
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>
        </Grid>

        <TextBlock Text="{x:Bind Caption, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap" />

        <InfoBar IsClosable="False"
                 IsOpen="{x:Bind ViewModel.NotificationContext.IsOpen, Mode=OneWay}"
                 Opacity="{x:Bind GetOpacity(ViewModel.NotificationContext.IsOpen), Mode=OneWay}"
                 Severity="{x:Bind ViewModel.NotificationContext.Severity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.NotificationContext.Title, Mode=OneWay}"
                 Message="{x:Bind ViewModel.NotificationContext.Message, Mode=OneWay}">

            <InfoBar.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </InfoBar.Transitions>
        </InfoBar>

        <ContentPresenter Content="{x:Bind FormContent, Mode=OneWay}" />

        <Button Command="{x:Bind ViewModel.SubmitFormCommand, Mode=OneWay}"
                IsEnabled="{x:Bind Inverse(ViewModel.IsProcessing), Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Width="200">
            <StackPanel Spacing="16" Orientation="Horizontal">
                <ProgressRing IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                              Visibility="{x:Bind GetVisibility(ViewModel.IsProcessing), Mode=OneWay}"
                              Width="16" Height="16"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind SubmitButtonText, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>