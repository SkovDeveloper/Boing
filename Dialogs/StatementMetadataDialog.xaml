<ContentDialog
    x:Class="Boing.Dialogs.StatementMetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl
        Width="440"
        Title="{x:Bind ViewModel.DialogTitle}"
        Caption="{x:Bind ViewModel.DialogCaption}"
        SubmitButtonText="{x:Bind ViewModel.SubmitButtonText}"
        ViewModel="{x:Bind ViewModel}">

        <StackPanel GotFocus="{x:Bind ViewModel.HideNotification}" Spacing="16">
            <TextBox
                Header="Nombre de la empresa"
                PlaceholderText="Ej. Boing de Mango"
                Text="{x:Bind ViewModel.CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CalendarDatePicker
                    Grid.Column="0"
                    Header="Del"
                    Date="{x:Bind ViewModel.PeriodStart, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

                <CalendarDatePicker
                    Grid.Column="1"
                    Header="Al"
                    Date="{x:Bind ViewModel.PeriodEnd, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="Elaboró"
                    PlaceholderText="Ej. C.P. Ariel Morales"
                    Text="{x:Bind ViewModel.PreparedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Stretch" />

                <TextBox
                    Grid.Column="1"
                    Header="Autorizó"
                    PlaceholderText="Ej. Dirección General"
                    Text="{x:Bind ViewModel.AuthorizedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>