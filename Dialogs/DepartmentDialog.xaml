<ContentDialog
    x:Class="Boing.Dialogs.DepartmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl
        Width="440"
        Title="{x:Bind ViewModel.DialogTitle}"
        Caption="{x:Bind ViewModel.DialogCaption}"
        SubmitButtonText="{x:Bind ViewModel.SubmitButtonText}"
        ViewModel="{x:Bind ViewModel}">

        <StackPanel GotFocus="{x:Bind ViewModel.HideNotification}" Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="Alias"
                    Text="{x:Bind ViewModel.Alias}"
                    IsReadOnly="True"
                    IsTabStop="False"
                    HorizontalAlignment="Stretch" />

                <TextBox
                    Grid.Column="1"
                    Header="Nombre"
                    PlaceholderText="Ej. Etiquetado"
                    Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Stretch" />

                <ComboBox
                    Grid.Column="2"
                    Header="Tipo"
                    ItemsSource="{x:Bind ViewModel.TypeOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedTypeIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <NumberBox
                Header="Tarifa MOD por hora ($)"
                Visibility="{x:Bind ViewModel.ProductiveVisibility, Mode=OneWay}"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.DirectLaborHourlyRate, Mode=TwoWay}"
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ServiceVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox
                    Grid.Column="0"
                    Header="Orden cierre"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.SecondaryCloseOrder, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

                <ComboBox
                    Grid.Column="1"
                    Header="Base de cierre"
                    IsEditable="True"
                    ItemsSource="{x:Bind ViewModel.SecondaryBaseOptions}"
                    Text="{x:Bind ViewModel.SecondaryAllocationBaseKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox
                    Grid.Column="0"
                    Header="Metros cuadrados (m²)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.SquareMeters, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

                <NumberBox
                    Grid.Column="1"
                    Header="Kilowatts (kW)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.Kilowatts, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ProductiveVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox
                    Grid.Column="0"
                    Header="Horas-máquina"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.MachineHours, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

                <NumberBox
                    Grid.Column="1"
                    Header="Base materia prima"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.RawMaterialBase, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>