<ContentDialog
    x:Class="Boing.Dialogs.MaterialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl
        Width="420"
        Title="{x:Bind ViewModel.DialogTitle}"
        Caption="{x:Bind ViewModel.DialogCaption}"
        SubmitButtonText="{x:Bind ViewModel.SubmitButtonText}"
        ViewModel="{x:Bind ViewModel}">

        <StackPanel GotFocus="{x:Bind ViewModel.HideNotification}" Spacing="16">
            <TextBox
                Header="Nombre del ingrediente"
                PlaceholderText="Ej. Pulpa de mango"
                Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Header="Unidad de medida"
                    IsEditable="True"
                    ItemsSource="{x:Bind ViewModel.UnitOptions}"
                    Text="{x:Bind ViewModel.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Stretch" />

                <ComboBox
                    Grid.Column="1"
                    Header="Clasificación"
                    ItemsSource="{x:Bind ViewModel.ClassificationOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedClassificationIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox
                    Grid.Column="0"
                    Header="Cantidad inicial"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.InitialQuantity, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

                <NumberBox
                    Grid.Column="1"
                    Header="Costo unitario inicial ($)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.InitialUnitCost, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>