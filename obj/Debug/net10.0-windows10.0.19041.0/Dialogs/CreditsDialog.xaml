<ContentDialog
    x:Class="Boing.Dialogs.CreditsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cerrar"
    DefaultButton="Close"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Width="420" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Image
                    Source="ms-appx:///Assets/ApplicationImages/TaskBarIcon.png"
                    Width="48"
                    Height="48"
                    Stretch="Uniform" />

                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="Boing de Mango"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Proyecto académico original"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                Text="Sistema de control de tarjetas de almacén, prorrateos industriales, costo unitario de producción y estados financieros."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="6">
                <TextBlock
                    Text="Desarrollado por"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Spacing="2">
                    <TextBlock Text="Ángel Ariel Morales González" />
                    <TextBlock Text="Brenda Cifuentes Aguilar" />
                    <TextBlock Text="Pablo Alberto Aguilar Loza" />
                    <TextBlock Text="Juan Pablo Arreola Rojas" />
                    <TextBlock Text="Daniela Hernández Espinoza" />
                    <TextBlock Text="Luis Donovan Hernández Reyes" />
                    <TextBlock Text="María Fernanda Luna Rubio" />
                </StackPanel>

                <TextBlock
                    Margin="0,6,0,0"
                    Text="Para Contabilidad Financiera y de Costos"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                FontSize="10"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Software académico de carácter estrictamente no comercial, creado originalmente para fines exclusivos de evaluación escolar. El código fuente, la arquitectura y el diseño son propiedad intelectual exclusiva de su autor titular; queda prohibida su reproducción, redistribución o uso externo sin autorización expresa. Derechos reservados, © 2026." />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

