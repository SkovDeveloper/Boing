<ContentDialog x:ConnectionId='1'
    x:Class="Boing.Dialogs.MaterialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl x:ConnectionId='2'
        Width="420"
                                              
                                                  
                                                              
                                      >

        <StackPanel x:ConnectionId='3'                                                Spacing="16">
            <TextBox x:ConnectionId='4'
                Header="Nombre del ingrediente"
                PlaceholderText="Ej. Pulpa de mango"
                                                                                                
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox x:ConnectionId='7'
                    Grid.Column="0"
                    Header="Unidad de medida"
                    IsEditable="True"
                                                                
                                                                                                    
                    HorizontalAlignment="Stretch" />

                <ComboBox x:ConnectionId='8'
                    Grid.Column="1"
                    Header="Clasificación"
                                                                          
                                                                                               
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox x:ConnectionId='5'
                    Grid.Column="0"
                    Header="Cantidad inicial"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                           
                    HorizontalAlignment="Stretch" />

                <NumberBox x:ConnectionId='6'
                    Grid.Column="1"
                    Header="Costo unitario inicial ($)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                           
                    HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>

