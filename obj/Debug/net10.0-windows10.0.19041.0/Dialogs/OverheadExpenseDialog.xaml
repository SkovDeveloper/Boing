<ContentDialog x:ConnectionId='1'
    x:Class="Boing.Dialogs.OverheadExpenseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl x:ConnectionId='2'
        Width="420"
                                              
                                                  
                                                              
                                      >

        <StackPanel x:ConnectionId='3'                                                Spacing="16">
            <TextBox x:ConnectionId='4'
                Header="Concepto del gasto"
                PlaceholderText="Ej. Renta de planta"
                                                                                                   
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox x:ConnectionId='7'
                    Grid.Column="0"
                    Header="Monto ($)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                  
                    HorizontalAlignment="Stretch" />

                <ComboBox x:ConnectionId='8'
                    Grid.Column="1"
                    Header="Tipo de distribución"
                                                                          
                                                                                               
                    HorizontalAlignment="Stretch" />
            </Grid>

            <ComboBox x:ConnectionId='5'
                Header="Base métrica"
                IsEditable="True"
                                                                             
                                                                  
                                                                                                             
                HorizontalAlignment="Stretch" />

            <ComboBox x:ConnectionId='6'
                Header="Departamento destino"
                                                                             
                                                            
                                                                                       
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch" />
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>

