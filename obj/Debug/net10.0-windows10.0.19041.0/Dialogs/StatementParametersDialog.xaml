<ContentDialog x:ConnectionId='1'
    x:Class="Boing.Dialogs.StatementParametersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl x:ConnectionId='2'
        Width="420"
                                              
                                                  
                                                              
                                      >

        <StackPanel x:ConnectionId='3'                                                Spacing="16">
            <NumberBox x:ConnectionId='4'
                Header="Inventario inicial de artículos terminados ($)"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                                                                            
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox x:ConnectionId='5'
                    Grid.Column="0"
                    Header="Gastos de venta ($)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                           
                    HorizontalAlignment="Stretch" />

                <NumberBox x:ConnectionId='6'
                    Grid.Column="1"
                    Header="Gastos de administración ($)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                         
                    HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>

