<ContentDialog x:ConnectionId='1'
    x:Class="Boing.Dialogs.DepartmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl x:ConnectionId='2'
        Width="440"
                                              
                                                  
                                                              
                                      >

        <StackPanel x:ConnectionId='3'                                                Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:ConnectionId='13'
                    Grid.Column="0"
                    Header="Alias"
                                                   
                    IsReadOnly="True"
                    IsTabStop="False"
                    HorizontalAlignment="Stretch" />

                <TextBox x:ConnectionId='14'
                    Grid.Column="1"
                    Header="Nombre"
                    PlaceholderText="Ej. Etiquetado"
                                                                                                    
                    HorizontalAlignment="Stretch" />

                <ComboBox x:ConnectionId='15'
                    Grid.Column="2"
                    Header="Tipo"
                                                                
                                                                                     
                    HorizontalAlignment="Stretch" />
            </Grid>

            <NumberBox x:ConnectionId='4'
                Header="Tarifa MOD por hora ($)"
                                                                                 
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                                                                             
                HorizontalAlignment="Stretch" />

            <Grid x:ConnectionId='5' ColumnSpacing="12"                                                               >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox x:ConnectionId='11'
                    Grid.Column="0"
                    Header="Orden cierre"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                                                                               
                    HorizontalAlignment="Stretch" />

                <ComboBox x:ConnectionId='12'
                    Grid.Column="1"
                    Header="Base de cierre"
                    IsEditable="True"
                                                                         
                                                                                                                          
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox x:ConnectionId='9'
                    Grid.Column="0"
                    Header="Metros cuadrados (m²)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                        
                    HorizontalAlignment="Stretch" />

                <NumberBox x:ConnectionId='10'
                    Grid.Column="1"
                    Header="Kilowatts (kW)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                     
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid x:ConnectionId='6' ColumnSpacing="12"                                                                  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox x:ConnectionId='7'
                    Grid.Column="0"
                    Header="Horas-máquina"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                        
                    HorizontalAlignment="Stretch" />

                <NumberBox x:ConnectionId='8'
                    Grid.Column="1"
                    Header="Base materia prima"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                           
                    HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>

