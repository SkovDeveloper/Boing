<ContentDialog x:ConnectionId='1'
    x:Class="Boing.Dialogs.StatementMetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl x:ConnectionId='2'
        Width="440"
                                              
                                                  
                                                              
                                      >

        <StackPanel x:ConnectionId='3'                                                Spacing="16">
            <TextBox x:ConnectionId='4'
                Header="Nombre de la empresa"
                PlaceholderText="Ej. Boing de Mango"
                                                                                                       
                HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CalendarDatePicker x:ConnectionId='7'
                    Grid.Column="0"
                    Header="Del"
                                                                      
                    HorizontalAlignment="Stretch" />

                <CalendarDatePicker x:ConnectionId='8'
                    Grid.Column="1"
                    Header="Al"
                                                                    
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:ConnectionId='5'
                    Grid.Column="0"
                    Header="Elaboró"
                    PlaceholderText="Ej. C.P. Ariel Morales"
                                                                                                          
                    HorizontalAlignment="Stretch" />

                <TextBox x:ConnectionId='6'
                    Grid.Column="1"
                    Header="Autorizó"
                    PlaceholderText="Ej. Dirección General"
                                                                                                            
                    HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>

