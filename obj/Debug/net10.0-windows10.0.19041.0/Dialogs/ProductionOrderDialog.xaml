<ContentDialog x:ConnectionId='1'
    x:Class="Boing.Dialogs.ProductionOrderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boing.UIControls"
    xmlns:vm="using:Boing.ViewModels"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <controls:DialogTemplateControl x:ConnectionId='2'
        Width="440"
                                              
                                                  
                                                              
                                      >

        <StackPanel x:ConnectionId='3'                                                Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:ConnectionId='12'
                    Grid.Column="0"
                    Header="Folio de orden"
                    PlaceholderText="Ej. SkO:004v"
                                                                                                    
                    HorizontalAlignment="Stretch" />

                <ComboBox x:ConnectionId='13'
                    Grid.Column="1"
                    Header="Estado"
                                                                  
                                                                                       
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <NumberBox x:ConnectionId='10'
                    Grid.Column="0"
                    Header="Unidades producidas"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                         
                    HorizontalAlignment="Stretch" />

                <NumberBox x:ConnectionId='11'
                    Grid.Column="1"
                    Header="Unidades vendidas"
                                                                                    
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                                                                     
                    HorizontalAlignment="Stretch" />
            </Grid>

            <NumberBox x:ConnectionId='4'
                Header="Inventario inicial en proceso ($)"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                                                                                
                HorizontalAlignment="Stretch" />

            <StackPanel Spacing="8">
                <TextBlock
                    Text="Horas de mano de obra directa (MOD)"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <ItemsRepeater x:ConnectionId='5'                                              >
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate                                    >
                            <Grid x:ConnectionId='7' ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:ConnectionId='8'
                                    Grid.Column="0"
                                                                  
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <NumberBox x:ConnectionId='9'
                                    Grid.Column="1"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact"
                                                                       
                                    HorizontalAlignment="Stretch" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </controls:DialogTemplateControl>
</ContentDialog>

