<UserControl x:ConnectionId='1' x:Class="Boing.UIControls.DialogTemplateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="16" Spacing="24">

        <StackPanel.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </TransitionCollection>
        </StackPanel.ChildrenTransitions>

        <Grid Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:ConnectionId='8' Grid.Column="0"
                                                         
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <Button x:ConnectionId='9' Grid.Column="1"
                                                                               
                    Style="{ThemeResource SubtleButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="44" Height="44">
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>
        </Grid>

        <TextBlock x:ConnectionId='2'                                     
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap" />

        <InfoBar x:ConnectionId='3' IsClosable="False"
                                                                                    
                                                                                                 
                                                                                        
                                                                                  
                                                                                      >

            <InfoBar.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </InfoBar.Transitions>
        </InfoBar>

        <ContentPresenter x:ConnectionId='4'                                             />

        <Button x:ConnectionId='5'                                                            
                                                                                 
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Width="200">
            <StackPanel Spacing="16" Orientation="Horizontal">
                <ProgressRing x:ConnectionId='6'                                                        
                                                                                                      
                              Width="16" Height="16"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <TextBlock x:ConnectionId='7'                                               VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

