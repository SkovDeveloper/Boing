<Page x:ConnectionId='1'
    x:Class="Boing.Views.EcpvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="24" Margin="0,0,48,48">
        <StackPanel x:ConnectionId='2' Spacing="8"                                                            >
            <StackPanel Spacing="2" Margin="4,0,0,8">
                <TextBlock x:ConnectionId='42'                                                          Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Estado de costo de producción y de lo vendido" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:ConnectionId='43'                                                         Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <controls:SettingsExpander x:ConnectionId='22'
                IsExpanded="True"
                Header="Materia prima directa"
                                                                                 >

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Inventario inicial de materia prima directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='41'                                                                     />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Compras netas de materia prima directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='40'                                                                       />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Materia prima directa disponible">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='39'                                                                       />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Inventario final de materia prima directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='38'                                                                   />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Materia prima directa utilizada">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='37'                                                                  />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:ConnectionId='23'
                IsExpanded="True"
                Header="Costo incurrido"
                                                                                 >

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D2;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Mano de obra directa">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='36'                                                           />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Cargos indirectos de fabricación">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='35'                                                        />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo incurrido">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='34'                                                            />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:ConnectionId='24'
                IsExpanded="True"
                Header="Producción en proceso"
                                                                                >

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9F9;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Inventario inicial de producción en proceso">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='33'                                                          />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Producción procesada disponible">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='32'                                                              />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Inventario final de producción en proceso">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='31'                                                        />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo de producción de artículos terminados">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='30'                                                                  />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:ConnectionId='25'
                IsExpanded="True"
                Header="Artículos terminados y costo de lo vendido"
                                                                             >

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE719;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Inventario inicial de artículos terminados">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='29'                                                         />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Artículos terminados disponibles">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='28'                                                           />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Inventario final de artículos terminados">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='27'                                                       />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo de producción de lo vendido">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='26'                                                               />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>

        <StackPanel x:ConnectionId='3' Spacing="8"                                                          >
            <StackPanel Spacing="2" Margin="4,0,0,8">
                <TextBlock x:ConnectionId='20'                                                          Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Estado de resultados" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:ConnectionId='21'                                                         Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <controls:SettingsExpander x:ConnectionId='10'
                IsExpanded="True"
                Header="Ventas y utilidad bruta"
                                                                                    >

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8C7;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Ventas netas">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='19'                                                     />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Costo de producción de lo vendido">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='18'                                                               />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:ConnectionId='16'                                                           >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='17'                                                           />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:ConnectionId='11'
                IsExpanded="True"
                Header="Gastos de operación y resultado"
                                                                                        >

                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Gastos de venta">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='15'                                                               />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Gastos de administración">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE738;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='14'                                                             />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:ConnectionId='12'                                                               >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE94E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:ConnectionId='13'                                                               />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>

        <controls:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
            <Grid Padding="12,16" ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center" Width="280">
                    <Grid Height="96">
                        <Canvas x:ConnectionId='8'
                            x:Name="PreparedSignatureCanvas"
                            Background="Transparent"
                                                                      
                                                                  
                                                                        
                                                                         />
                        <Button x:ConnectionId='9'
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28"
                            Height="28"
                            Padding="0"
                            ToolTipService.ToolTip="Limpiar firma"
                                                                 >
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:ConnectionId='7'                                                          HorizontalAlignment="Center" />
                    <TextBlock Text="Elaboró" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center" Width="280">
                    <Grid Height="96">
                        <Canvas x:ConnectionId='5'
                            x:Name="AuthorizedSignatureCanvas"
                            Background="Transparent"
                                                                      
                                                                  
                                                                        
                                                                         />
                        <Button x:ConnectionId='6'
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28"
                            Height="28"
                            Padding="0"
                            ToolTipService.ToolTip="Limpiar firma"
                                                                   >
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:ConnectionId='4'                                                            HorizontalAlignment="Center" />
                    <TextBlock Text="Autorizó" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </controls:SettingsCard>
    </StackPanel>
</Page>

